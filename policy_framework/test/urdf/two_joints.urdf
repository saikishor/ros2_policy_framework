<?xml version="1.0"?>
<!-- base_link -j1 (z)-> link1 -j2 (y, 1 m along x)-> link2 -fixed (1 m up, yaw 90 deg)-> imu_link.
     Asymmetric on purpose: swapping the joint values gives a different transform. -->
<robot name="two_joints">
  <link name="base_link"/>
  <link name="link1"/>
  <link name="link2"/>
  <link name="imu_link"/>
  <link name="side_link"/>
  <joint name="j1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.2" upper="3.2" effort="1" velocity="1"/>
  </joint>
  <joint name="j2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="1 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.2" upper="3.2" effort="1" velocity="1"/>
  </joint>
  <joint name="imu_joint" type="fixed">
    <parent link="link2"/>
    <child link="imu_link"/>
    <origin xyz="0 0 1" rpy="0 0 1.5707963267948966"/>
  </joint>
  <!-- Not on the base_link -> imu_link chain. -->
  <joint name="side_joint" type="fixed">
    <parent link="base_link"/>
    <child link="side_link"/>
  </joint>
</robot>
